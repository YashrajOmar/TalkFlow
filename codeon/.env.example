# Database
DATABASE_URL=postgresql://codeon:codeon_dev@localhost:5432/codeon_dev

# Redis
REDIS_URL=redis://localhost:6379

# API Server
PORT=3001
NODE_ENV=development

# AI Providers (only one required — system is provider-agnostic)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Active AI provider: gemini | openai | anthropic | ollama
ACTIVE_REASONING_PROVIDER=ollama

# Auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Execution Sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Sandbox provider: judge0 | docker | mock
ACTIVE_SANDBOX_PROVIDER=mock

# Feature Flags
FEATURE_EXPERIMENTAL_NATIVE_TRAIL=true
FEATURE_EXPERIMENTAL_LEARNING_GRAPH=true
FEATURE_EXPERIMENTAL_RECOMMENDATIONS=false
FEATURE_EXPERIMENTAL_LEARNING_TWIN=false
FEATURE_EXPERIMENTAL_CONTEST_MODE=false
FEATURE_EXPERIMENTAL_INTERVIEW_MODE=true
